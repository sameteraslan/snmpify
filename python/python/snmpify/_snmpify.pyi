from collections.abc import AsyncIterator, Awaitable, Callable, Iterable, Iterator, Mapping
from os import PathLike
from typing import Any, Optional, Union

Value = Any
VarBinds = Union[Iterable[tuple[str, Value]], Mapping[str, Value]]
OidList = Union[str, Iterable[str]]

__version__: str

class UsmUser:
    def __init__(
        self,
        name: str,
        auth: Optional[tuple[str, str]] = None,
        privacy: Optional[tuple[str, str]] = None,
    ) -> None: ...
    @property
    def name(self) -> str: ...
    @property
    def level(self) -> str: ...

class Walk(Iterator[tuple[str, Value]]):
    def __next__(self) -> tuple[str, Value]: ...

class AsyncWalk(AsyncIterator[tuple[str, Value]]):
    def __anext__(self) -> Awaitable[tuple[str, Value]]: ...

class Client:
    def __init__(
        self,
        target: str,
        community: str = "public",
        version: str = "2c",
        *,
        user: Optional[UsmUser] = None,
        context: Optional[str] = None,
        timeout: float = 1.0,
        retries: int = 2,
        max_repetitions: int = 25,
    ) -> None: ...
    @property
    def version(self) -> str: ...
    @property
    def target(self) -> str: ...
    @property
    def engine_id(self) -> Optional[bytes]: ...
    def get(self, oid: str) -> Value: ...
    def get_many(self, oids: OidList) -> list[tuple[str, Value]]: ...
    def get_next(self, oids: OidList) -> list[tuple[str, Value]]: ...
    def get_bulk(self, oids: OidList, non_repeaters: int = 0, max_repetitions: int = 10) -> list[tuple[str, Value]]: ...
    def set(self, varbinds: VarBinds) -> list[tuple[str, Value]]: ...
    def walk(self, oid: str) -> Walk: ...
    def trap(self, trap_oid: str, varbinds: Optional[VarBinds] = None) -> None: ...
    def inform(self, trap_oid: str, varbinds: Optional[VarBinds] = None) -> list[tuple[str, Value]]: ...

class AsyncClient:
    def __init__(
        self,
        target: str,
        community: str = "public",
        version: str = "2c",
        *,
        user: Optional[UsmUser] = None,
        context: Optional[str] = None,
        timeout: float = 1.0,
        retries: int = 2,
        max_repetitions: int = 25,
    ) -> None: ...
    @property
    def version(self) -> str: ...
    @property
    def target(self) -> str: ...
    @property
    def engine_id(self) -> Optional[bytes]: ...
    async def get(self, oid: str) -> Value: ...
    async def get_many(self, oids: OidList) -> list[tuple[str, Value]]: ...
    async def get_next(self, oids: OidList) -> list[tuple[str, Value]]: ...
    async def get_bulk(self, oids: OidList, non_repeaters: int = 0, max_repetitions: int = 10) -> list[tuple[str, Value]]: ...
    async def set(self, varbinds: VarBinds) -> list[tuple[str, Value]]: ...
    def walk(self, oid: str) -> AsyncWalk: ...
    async def trap(self, trap_oid: str, varbinds: Optional[VarBinds] = None) -> None: ...
    async def inform(self, trap_oid: str, varbinds: Optional[VarBinds] = None) -> list[tuple[str, Value]]: ...

class Notification:
    @property
    def kind(self) -> str: ...
    @property
    def source(self) -> str: ...
    @property
    def version(self) -> str: ...
    @property
    def community(self) -> Optional[bytes]: ...
    @property
    def user(self) -> Optional[str]: ...
    @property
    def level(self) -> Optional[str]: ...
    @property
    def trap_oid(self) -> str: ...
    @property
    def uptime(self) -> Optional[int]: ...
    @property
    def varbinds(self) -> list[tuple[str, Value]]: ...

class NotificationReceiver(AsyncIterator[Notification]):
    def __init__(
        self,
        address: str = "0.0.0.0:162",
        communities: Optional[list[str]] = ["public"],
        users: list[UsmUser] = [],
        engine_id: Optional[bytes] = None,
    ) -> None: ...
    @property
    def address(self) -> str: ...
    def recv(self, timeout: Optional[float] = None) -> Optional[Notification]: ...
    async def recv_async(self) -> Notification: ...
    def __anext__(self) -> Awaitable[Notification]: ...

class Agent:
    def __init__(
        self,
        address: str = "0.0.0.0:161",
        communities: Optional[dict[str, str]] = None,
        users: list[tuple[UsmUser, str]] = [],
        engine_id: Optional[bytes] = None,
    ) -> None: ...
    @property
    def address(self) -> str: ...
    def set(self, oid: str, value: Value, writable: bool = False) -> None: ...
    def set_callback(self, oid: str, callback: Callable[[], Value]) -> None: ...
    def get(self, oid: str) -> Optional[Value]: ...
    def remove(self, oid: str) -> bool: ...
    def start(self) -> None: ...
    def stop(self) -> None: ...
    def __enter__(self) -> "Agent": ...
    def __exit__(self, *args: object) -> None: ...

class Mib:
    def __init__(self, standard: bool = True) -> None: ...
    def load_file(self, path: Union[str, PathLike[str]]) -> list[str]: ...
    def load_str(self, text: str) -> list[str]: ...
    def load_dir(self, path: Union[str, PathLike[str]]) -> tuple[list[str], list[str]]: ...
    def resolve(self, name: str) -> str: ...
    def name(self, oid: str) -> str: ...
    def format(self, oid: str, value: Value) -> str: ...
    def format_value(self, oid: str, value: Value) -> str: ...
    def object(self, name: str) -> Optional[dict[str, Any]]: ...
    @property
    def modules(self) -> list[str]: ...
